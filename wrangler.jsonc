// Cloudflare production for coverflow.ashishgogula.in, deployed from cf-main.
// Workers Builds: build `npm run cf:build` (worker/build.sh), deploy
// `npx wrangler@4.154.0 deploy`, build variable NODE_VERSION=22. Deploy only
// from Workers Builds, never a laptop: a local out/ can hold untracked files.
// Static assets only: no Worker code, no secrets.
{
  "name": "coverflow",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
